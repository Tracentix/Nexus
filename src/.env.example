# Copy this file to .env and adjust the values for your environment.
# Never commit a real .env file.

# Secret key used to sign session cookies. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string

# Database location. Defaults to a local SQLite file (nexus.db).
DATABASE_URL=sqlite:///nexus.db

# Where password-reset links go. "console" prints them in the server log.
MAIL_DELIVERY=console
